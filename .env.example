# ==============================================================================
# Gate402 Environment Configuration
# Copy to .env (for contract deployment) and apps/web/.env.local (for web app)
# NEVER commit real private keys or API keys!
# ==============================================================================

# --- BNB Smart Chain RPC ---
BSC_RPC_URL=https://bsc-dataseed.binance.org/
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org/

# --- Official SPACE ID Agent ID HandleRegistry (BSC Mainnet) ---
AGENT_ID_REGISTRY_ADDRESS=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
NEXT_PUBLIC_AGENT_ID_REGISTRY_ADDRESS=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F

# --- Deployed Gate402Registry Contract Address (set after `pnpm deploy:bsc`) ---
GATE402_CONTRACT_ADDRESS=
NEXT_PUBLIC_GATE402_CONTRACT_ADDRESS=

# --- x402 Payment Recipient (your BSC wallet receiving paid x402 overflow in USDT) ---
GATE402_PAY_TO_ADDRESS=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Contract Deployment ONLY (use a fresh dedicated deployer wallet with ~$3 BNB) ---
DEPLOYER_PRIVATE_KEY=
BSCSCAN_API_KEY=

# --- Optional: Free Upstash Redis for persistent multi-instance quota metering ---
# Leave blank to use built-in in-memory + on-chain quota tracking ($0.00)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: Custom x402 Facilitator URL for live Permit2 settlement ---
X402_FACILITATOR_URL=
